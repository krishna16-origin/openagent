+def _raise_provider_error(r: "httpx.Response") -> None:
+    """httpx's default raise_for_status() message is just the status line
+    ("Client error '400 Bad Request' for url '...'") -- it never includes the
+    provider's own response body, which is where the actual reason lives
+    (invalid/decommissioned model, malformed request, bad key, etc). Pull that
+    body out so callers -- and the person reading the chat error -- see why the
+    call actually failed, not just that it failed.
+    """
+    if r.status_code < 400:
+        return
+    try:
+        body = r.json()
+        detail = (body.get("error") or {}).get("message") if isinstance(body, dict) else None
+        detail = detail or (str(body)[:300] if body else "")
+    except Exception:
+        detail = (r.text or "")[:300]
+    raise OmniRouteError(f"provider returned HTTP {r.status_code}: {redact(detail) or '(no detail)'}")
+
